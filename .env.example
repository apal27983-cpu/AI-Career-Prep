# ---------------------------------------------------------------------------
# AI Career Preparation - example environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/career_prep?schema=public"
# Separate database used by the integration test suite (optional).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/career_prep_test?schema=public"

# --- Server -----------------------------------------------------------------
NODE_ENV="development"
PORT=4000
# Explicit API port, used in preference to PORT when set. Keeps the API off the
# web dev server port when a combined launcher sets PORT for the whole workspace.
API_PORT=4000
# Comma separated list of browser origins allowed to call the API.
FRONTEND_URL="http://localhost:5173"
# Long random string (>= 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Session lifetime in days.
SESSION_TTL_DAYS=7
# SameSite policy for the session cookie: "lax" | "none".
# Use "lax" when the browser app and the API share a domain (and for local dev).
# Use "none" ONLY when they are on different domains - for example a Vercel
# frontend calling a separately hosted API. It requires HTTPS and
# NODE_ENV="production", because the browser rejects SameSite=None without Secure.
SESSION_COOKIE_SAMESITE="lax"
# Set to "true" only when serving the API over HTTPS behind a proxy.
TRUST_PROXY="false"

# --- LLM provider (SERVER SIDE ONLY - never prefix with VITE_) ---------------
# Supported providers: "anthropic" | "openai" | "mock"
# Use "mock" to run the whole app end to end with a deterministic local
# fallback engine and no external API calls or costs.
LLM_PROVIDER="openai"
LLM_API_KEY="replace-with-your-server-side-api-key"
# Leave empty to use the provider default:
#   anthropic -> claude-opus-5-5
#   openai    -> gpt-5.5
# Verified alternatives for openai: gpt-5.4-mini (fastest), gpt-6.1-sol (slowest).
LLM_MODEL=""
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
# Reasoning depth / token spend: low | medium | high | xhigh | max
# On openai this maps to reasoning_effort; "max" folds to "xhigh".
LLM_EFFORT="medium"
# Anthropic only: server-side refusal fallback. Ignored by other providers, and
# turned off automatically if your account rejects the beta flag.
LLM_SERVER_FALLBACKS="true"

# --- Resume uploads ---------------------------------------------------------
MAX_RESUME_SIZE_MB=5
# Private directory for uploaded resumes. Must NOT be web-served.
RESUME_STORAGE_DIR="./storage/resumes"
# "memory" processes uploads in RAM only; "disk" persists the original file.
RESUME_STORAGE_MODE="disk"

# --- Rate limits / cost control --------------------------------------------
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MINUTES=15
# Maximum AI-backed interview sessions a single user may create per day.
MAX_INTERVIEW_SESSIONS_PER_DAY=20

# --- Logging ----------------------------------------------------------------
LOG_LEVEL="info"
