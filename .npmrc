# Keep devDependencies on install, even when NODE_ENV=production.
#
# The API is compiled on the host it runs on, and `tsc`, `@types/node` and the
# Prisma CLI are all devDependencies. A host that sets NODE_ENV=production -
# which Render and most platforms do - makes `npm install` omit them, and the
# build dies at:
#
#   error TS2688: Cannot find type definition file for 'node'
#
# Putting it here rather than relying on `--include=dev` in a dashboard build
# command means the repository builds correctly wherever it is cloned.
include=dev
