{
  "name": "@career-prep/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/security",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@career-prep/shared": "*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.2.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "mammoth": "1.8.0",
    "multer": "^2.0.1",
    "openai": "^7.39.0",
    "pdfjs-dist": "4.10.38",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/supertest": "6.0.2",
    "supertest": "^7.1.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
