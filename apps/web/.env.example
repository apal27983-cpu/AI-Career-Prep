# ---------------------------------------------------------------------------
# Frontend build-time configuration.
#
# Anything prefixed with VITE_ is EMBEDDED IN THE BROWSER BUNDLE and is public.
# Never put an API key, session secret or database URL here.
# ---------------------------------------------------------------------------

# Where the browser sends API calls.
#
# Leave as "/api/v1" when the frontend and API are served from one domain (the
# default, and what `npm run dev` does through the Vite proxy).
#
# Set the absolute origin when the API is deployed separately, e.g.
#   VITE_API_BASE_URL="https://career-prep-api.example.com/api/v1"
# That makes the requests cross-site, which also requires the API to set
# SESSION_COOKIE_SAMESITE="none" and to list this origin in FRONTEND_URL.
VITE_API_BASE_URL="/api/v1"

# Dev only: where `npm run dev` proxies /api to.
VITE_DEV_API_TARGET="http://localhost:4000"
